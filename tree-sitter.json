{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "httpyac",
      "camelcase": "HttpYac",
      "title": "Httpyac",
      "scope": "source.httpyac",
      "file-types": ["http"],
      "injection-regex": "^httpyac$",
      "class-name": "TreeSitterHttpyac"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for httpyac",
    "authors": [
      {
        "name": "Nathan Sharpe",
        "email": "nathan@nathanjsharpe.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-httpyac"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
